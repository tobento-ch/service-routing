{
    "name": "tobento/service-routing",
    "version": "2.0",
    "type": "library",
    "description": "A flexible PHP router.",
    "keywords": [
        "tobento",
        "package",
        "routing",
        "router"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,    
    "require": {
        "php": ">=8.4",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-support": "^2.0",
        "tobento/service-uri": "^2.0",
        "tobento/service-dater": "^2.0",
        "tobento/service-autowire": "^2.0",
        "tobento/service-middleware": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "laminas/laminas-httphandlerrunner": "^2.12"
    },   
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Routing\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Routing\\Test\\": "tests",
            "App\\": "build/app"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}